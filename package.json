{
  "name": "cursor-repo-qa",
  "version": "1.1.0",
  "private": true,
  "description": "在 GitHub 仓库页面提问，由 Cursor Cloud Agent 克隆仓库、阅读代码并回答。",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@primer/octicons": "^19.40.0",
    "@types/chrome": "^0.3.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1"
  }
}
