{
  "manifest_version": 3,
  "name": "Cursor 仓库问答",
  "description": "在 GitHub 仓库页面提问，由 Cursor Cloud Agent 克隆仓库、阅读代码并回答。",
  "version": "0.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://api.cursor.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Cursor 仓库问答 · 设置与聊天记录",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
