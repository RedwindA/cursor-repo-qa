{
  "manifest_version": 3,
  "name": "GitHub 仓库问答",
  "description": "在 GitHub 仓库页面提问，由 AI agent 阅读仓库代码并回答。支持自带模型 API（OpenAI 兼容 / Anthropic）或 Cursor Cloud Agent。",
  "version": "1.3.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.cursor.com/*",
    "https://codeload.github.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GitHub 仓库问答 · 设置与聊天记录",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}